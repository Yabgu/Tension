{
  "name": "tension-example-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: guest-synthesised PCM playback over the tension::audio ABI",
  "scripts": {
    "build": "tensionscript demo.ts -o build/demo.wasm --runtime incremental --target release",
    "build:debug": "tensionscript demo.ts -o build/demo.wasm --runtime incremental --target debug",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "plain",
    "wasm": "build/demo.wasm"
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "file:../../tools/assemblyscript-fork/yabgu_gm-tensionscript-0.3.2.tgz"
  }
}
