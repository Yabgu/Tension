{
  "name": "tension-example-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: guest-synthesised PCM playback over the tension::audio ABI",
  "scripts": {
    "build": "tensionscript demo.ts -o build/demo.wasm --runtime incremental --target release --optimizeLevel 3",
    "build:debug": "tensionscript demo.ts -o build/demo.wasm --runtime incremental --target debug --debug --sourceMap",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "plain",
    "wasm": "build/demo.wasm"
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework",
    "@yabgu_gm/tension-core": "file:../../packages/core"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.0"
  }
}
