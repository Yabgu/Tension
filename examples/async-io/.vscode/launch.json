{
  // Debugging `examples/async-io` under tension-core, on any platform.
  //
  // Why this example and not `async-on-main`: `async-on-main` is written for the
  // stack-switching backend, and on Windows wasmtime refuses continuation
  // modules outright. Its Promise-backend build is a guest in which `main` is
  // never reached — measured: exit 0, no output, `game/main` resolves but its
  // breakpoint has a hit count of 0 — so no launch configuration can make it
  // stop anywhere. `async-io` is a Promise-backend guest that runs here, and it
  // does stop, including on lines *after* an await (measured on this machine:
  // lines 48/49/50 around the first await, 67 after the task settles, 73 inside
  // the frame loop).
  //
  // The build is the example's own `build:debug`, which passes
  // `--config ../../tension-framework/build/session.asconfig.json`: the session
  // owns the arena, so a build without it is refused at load with
  // "`session::*` but declares no memory import".
  //
  // `windows` overrides the program to `.exe`; a relative path without it will
  // not launch on Windows.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "lldb: tension-core --debug (async-io, promise backend)",
      "program": "${workspaceFolder}/../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/game.wasm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "initCommands": [
        "settings set plugin.jit-loader.gdb.enable on",
        "settings set target.debug-file-search-paths ${workspaceFolder}"
      ],
      "sourceMap": { ".": "${workspaceFolder}" },
      "preLaunchTask": "debug",
      "stopOnEntry": false
    },
    {
      // The same guest built as a *release* artifact, for comparison: this one
      // carries no DWARF, so a source breakpoint does not bind. Kept because
      // "the breakpoint never hit" has two very different causes and this is
      // how a person tells them apart without leaving the editor.
      "type": "lldb",
      "request": "launch",
      "name": "lldb: tension-core (async-io, RELEASE — no DWARF, for comparison)",
      "program": "${workspaceFolder}/../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/game.wasm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "initCommands": ["settings set plugin.jit-loader.gdb.enable on"],
      "preLaunchTask": "build:release",
      "stopOnEntry": false
    }
  ]
}
