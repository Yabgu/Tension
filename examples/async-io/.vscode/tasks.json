{
  // The pre-launch tasks for `examples/async-io`.
  //
  // `build:debug` is the example's own script and is the one the launch
  // configuration names: `--debug --sourceMap` is what puts `.debug_line` in the
  // guest, and without it a source breakpoint has nothing to bind to. It also
  // passes the framework's session config, which this example's runtime needs
  // (the session owns the arena memory).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "npm run build:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build:release",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "debug",
      "dependsOn": ["build:debug"],
      "dependsOrder": "sequence"
    }
  ]
}
