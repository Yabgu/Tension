{
  "name": "tension-example-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: CLI arguments, printing and read-line over the tension::io ABI",
  "scripts": {
    "build": "tensionscript game.ts -o build/game.wasm --runtime incremental --target release --optimizeLevel 3",
    "build:debug": "tensionscript game.ts -o build/game.wasm --runtime incremental --debug --sourceMap",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "io",
    "stdin": "hello from the terminal\n",
    "args": [
      "alpha",
      "beta",
      "gamma"
    ]
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework"
  },
  "devDependencies": {
    "@acakar/tensionscript": "^0.9.0"
  }
}
