{
  // The pre-launch tasks. `asc` must emit the source map, because that map is
  // the only thing that links a wasm instruction back to a source line; a
  // release build carries no map, so source breakpoints cannot resolve. The
  // launch config names the compound "debug" task, which runs these in order.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "npm run build:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "pack",
      "type": "shell",
      "command": "node ../../scripts/run-example.mjs --pack-only",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "debug",
      "dependsOn": ["build:debug", "pack"],
      "dependsOrder": "sequence"
    }
  ]
}
