{
  "name": "tension-example-res",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: an ECMA-208 (SIDF) resource pak read through the tension::res ABI",
  "scripts": {
    "build": "node ./node_modules/@yabgu_gm/tensionscript/bin/tensionscript.js assembly/index.ts -o build/game.wasm --runtime incremental --target release --optimizeLevel 3",
    "build:debug": "node ./node_modules/@yabgu_gm/tensionscript/bin/tensionscript.js assembly/index.ts -o build/game.wasm --runtime incremental --target release --optimizeLevel 3 --debug --sourceMap",
    "pack": "node ../../scripts/pack-example.mjs .",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "res",
    "pack": {
      "input": "assets",
      "output": "game.tns",
      "generates": [
        {
          "file": "data/large.bin",
          "size": 20971520,
          "pattern": "keystream",
          "keep": "build/large.bin"
        },
        {
          "file": "data/compressed.bin",
          "size": 2097152,
          "pattern": "zeros",
          "keep": "build/compressed.bin"
        }
      ]
    }
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework",
    "@yabgu_gm/tension-core": "file:../../packages/core"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.1"
  }
}
