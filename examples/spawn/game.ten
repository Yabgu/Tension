// Floating tasks: spawn work and do not await it.
//
//   npm start
//
// The one new thing here is the *shape* of the call. `work(3);` in statement position is
// the program saying "start this and do not wait" — the value it returns is a task nobody
// keeps, so there is nothing to await and no one to report to. That is not a leak and not
// a fire-and-forget shrug: the backend you build for owns the queue, and every body runs
// before the program exits.
//
// On the fiber backend the guest cannot run the body itself (its stack is a host object),
// so it hands the slot to the host's ready queue and the host resumes it after the entry
// returns. On continuations the guest's own executor ring is the queue. Either way the
// order below is the order the tasks were handed over, because the default policy is FIFO.
//
// **Awaiting is the other choice, and it is a different program.** `await work(1)` runs the
// body before the next line and gives you its value; this file prints its three lines after
// the entry has already returned, which is why `done` comes last and not first.

import { print, rt } from "tension-framework";

/**
 * Something that takes a moment: **one real suspension** — `await rt.frame()` is a park on
 * the frame clock, whose producer is the host's own loop, so the artifact imports
 * `scheduler::park` and the body cannot be inlined away.
 *
 * (This used to await a local helper that `return 0`ed. An async function with no `await`
 * in its body is not lowered at all — DL59's lesson — so those two calls were ordinary
 * calls and the comment above them claiming "two suspensions" was false. The artifact is
 * what settles it: `spawn_park.rs` asserts this shape imports the park.)
 *
 * **But a park inside a body driven by the ready drain does not currently suspend** on
 * fiber: it returns immediately with no producer (I153, measured — `examples/spawn` prints
 * in the same millisecond, and so do the four OGRE examples' loads). So the ordering below
 * is the drain's, not the clock's, and the park's presence is asserted rather than its
 * effect. Fixing that is engine shape and is not this round's.
 */
async function step(label: string): i32 {
  let frame: i32 = await rt.frame();
  print("  step " + label + " (frame " + frame.toString() + ")");
  return 1;
}

/** A floating body: nobody awaits it, and it still runs to completion. */
async function work(id: i32): void {
  let done: i32 = await step(id.toString());
  print("work " + id.toString() + " finished (" + done.toString() + ")");
}

/** The frame clock, bound once: `rt.start()` is what lets a bare guest park at all. */
function bindRuntime(): void {
  rt.start();
}

export function _start_game(): void {
  bindRuntime();
  print("spawning three tasks and not awaiting any of them");
  work(1);
  work(2);
  work(3);
  print("the entry returns here; the host runs what was spawned");
}
