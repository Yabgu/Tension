{
  // The pre-launch tasks. `--sourceMap` is what links a wasm instruction back to
  // a source line, and a release build carries no map — so the debug task builds
  // the debug guest, exactly as every other example's does.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "npm run build:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "debug",
      "dependsOn": ["build:debug"],
      "dependsOrder": "sequence"
    },
    // The Promise build, for platforms whose engine cannot enable stack
    // switching (Windows: wasmtime refuses continuations there). Same flags as
    // `build:debug` minus `--enable stack-switching`, so the guest compiles to
    // the Promise shell — `__start` calls `main` and drains its ready queue.
    {
      "label": "build:debug:promise",
      "type": "shell",
      "command": "node ../../scripts/tensionscript.mjs game.ts -o build/debug/game.wasm --runtime incremental --debug --sourceMap --exportStart __start",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "debug:promise",
      "dependsOn": ["build:debug:promise"],
      "dependsOrder": "sequence"
    }
  ]
}
