// examples/ai/story.ten — the tension::ai demo.
//
// The host owns the model; the game owns the conversation. This example shows
// both guest services at once: tension::io for the terminal, tension::ai for
// the model. It opens one chat session and runs a read-eval-print loop.
//
//   tension-core ai/build/story.wasm [model.gguf]
//
// The model path is the game's first argument. It is required: the ABI says
// `session_create` refuses a config with no model key, so even the headless
// fallback is given one (it ignores the value and answers deterministically).
// Without the `ai` cargo feature, this demo therefore runs end-to-end with no
// GGUF file at all — any path will do.
//
// Commands: /reset, /cancel, /quit.
//
// ## The stream, and why the shape below is what it is
//
// A generation runs on the host's own thread. Before 0.6.0b the guest learned
// about it by polling — `while (session.state() == 1) { read(); }` — a busy-wait
// against an API that never yields. Now the host posts a completion
// (AI_READY / AI_DONE / AI_ERROR) through the arena's posting face and the guest
// **parks** on it:
//
//   const event: AiEvent = await rt.stream(session.handle());
//   if (event == AiEvent.Ready) { write(session.read()); }
//
// **One await per chunk, and the await answers the event** (DL57). It used to answer an
// `i32` — an unread byte count for READY, `0` for DONE, `-EIO` for ERROR — which the guest
// then had to decode by looking up the delivered class separately. `AiEvent` names it
// directly, so there is one call and no second question, and the text is read through
// `session.read()`, which takes exactly the chunk the event announced.
//
// One step, not two: an `async` accessor would return *its own* task, and awaiting that
// parks the wrapper, not the caller — the two-layer composition `rt.frame` was fixed for
// (0.7.0a). `rt.stream` is a stamped handle, so `await` parks this task on
// `(AI family, session)` directly.
//
// **This is measured, not promised.** `printf 'hello\n/quit\n' | npm run run` under the
// committed stub adapter prints its prompt, streams the reply in **four separately-posted
// chunks** (five `(AI_DONE, session)` parks: four `Ready` and one `Done`, each resumed in
// the same host pass that posted for it) and exits 0 — and the input side parks too, on
// `(IO_READY, 0)`, once per line. There is no `session.state()` in the loop and no yield
// loop around it, which is the "zero polls, zero yields" this file used to claim before it
// was true.
//
// ## Why there is one async function and no driver
//
// 0.7.0b moved this guest onto the host-owned loop. `_start_game` opens the
// session, creates the model session and **awaits** `run`; it does not pump, and it is
// `async` for exactly that reason — a bare `run(session)` under the stackful lowering is a
// task *factory*, so the call built a handle and dropped it while the body sat in
// `run$spawnStart` where nothing dispatched it (measured, DL56: the entry printed its
// command list and stopped, zero parks). Awaited, the entry *is* the task the host serves.
// The
// turn loop and the stream loop are **one** function, not two: `converse()` was
// an `async` helper, and `await converse(session)` parked *converse's* task —
// completing it would leave `run` on the ready queue, which the host loop never
// drains (pipeline-notes: an awaitable accessor returns a stamped handle, never
// an async wrapper). One function, so every `await` parks the task the host is
// waking.
//
// ## What the compiler forced (all measured, all in this file's shape)
//
// The async transform refuses, inside a lowered body: `break`, `continue`, a
// `<T>` cast or `as` assertion, a local declared after an `await`, an untyped
// local that crosses one, and a type argument. So the loop conditions carry the
// exits, every local that survives a park is typed at its declaration, and the
// two null-union refinements the REPL needs live in **non-async** code — the
// session is opened in `_start_game` and passed in as a parameter.

import {
  arg,
  argCount,
  ConfigBuilder,
  InputEvent,
  inputArm,
  inputTask,
  print,
  readLineNow,
  RuntimeSession,
  rt,
  write
} from "tension-framework";
import { AiConfig, AiEvent, AiRole, Session } from "tension-framework";
import { Task } from "~lib/task";
// The std's task machine: the table the push path parks in (0.7.0a).
import { __taskBindTable } from "~lib/task-rt";

// The host's wake entry. Re-exported because the linker drops an export the
// guest never names, and the host resolves `__taskWake` by name at load.
export { __taskWake, __taskResume, __taskFail } from "~lib/task-rt";

const SYSTEM_PROMPT =
  "You narrate a terse, atmospheric text adventure. Reply in at most two sentences.";

/// The whole conversation, as one task (0.7.0b).
///
/// Flattened from `converse` + `repl`: every `await` here parks **this** task, so
/// the host's wake resumes the loop itself. No `async` helper sits between
/// `_start_game` and the stream, and there is no `rt.runReady()` in the file.
///
/// No `break`, no `continue`: the transform refuses both in a lowered body, so
/// the loop conditions and flags carry every exit.
async function run(session: Session): void {
  // Typed at their declaration and declared before the first await: a local that
  // survives a park must be (the transform's documented limit).
  let running: bool = true;
  let text: string = "";
  let streaming: bool = true;
  let n: i32 = 0;
  let cleared: bool = false;
  // `handle` is a name the state struct reserves, so the awaited signal is
  // `signal`.
  let signal: Task<AiEvent> = rt.streamTask(session.handle());
  // The event the last await answered, declared with the others for the transform's sake.
  let chunk: AiEvent = AiEvent.Done;
  // The input event, declared with the others so it survives a park the way the
  // transform requires.
  let event: InputEvent = InputEvent.End;
  // **The reader runs on the host's thread, not this one** (DL57, I135). Arming is
  // idempotent and harmless to repeat.
  inputArm(0);

  while (running) {
    print("");
    write("you> ");
    // **Await a line; never read one blocking.** `readLine()` called into the host
    // inline, and under the fiber backend this guest's stack *is* a host thread — so that
    // call blocked the loop that would have delivered the next line. Measured four ways
    // (DL56): the first read never returned, `ai>` never printed, and there were zero
    // parks. Now the guest suspends, the host's reader posts, and the loop resumes.
    event = await inputTask(0);
    if (event == InputEvent.End) {
      // The source is over. Distinct from an empty line, which is a turn that said
      // nothing: this one says there will be no more turns.
      running = false;
    } else {
    text = readLineNow().trim();

    if (text.length == 0) {
      // An empty line is not a turn.
    } else if (text == "/quit") {
      running = false;
    } else if (text == "/reset") {
      cleared = session.reset();
      // reset clears the whole history, including the system prompt that makes
      // the model narrate. Restore it, or the next reply comes back from a
      // generic assistant instead of the game's narrator.
      if (cleared) session.add(AiRole.System, SYSTEM_PROMPT);
      print(cleared ? "(history cleared)" : "(cannot reset while generating)");
    } else if (text == "/cancel") {
      print(session.cancel() ? "(cancelled)" : "(nothing in flight)");
    } else {
      session.add(AiRole.User, text);
      if (!session.generate()) {
        print("(generate refused — drain the previous reply or cancel first)");
      } else {
        write("ai> ");
        streaming = true;
        while (streaming) {
          // **The await answers the event** (DL57, decision 3). One await per chunk: the
          // host parks this task until the stream has something to say, and what it says
          // is `AiEvent` — never a byte count the guest has to decode, and never a second
          // call to ask which class arrived.
          signal = rt.stream(session.handle());
          chunk = await signal;
          if (chunk == AiEvent.Error) {
            // The backend's own reason, if it had one, is already in the reply buffer.
            print("");
            print("(generation failed)");
            streaming = false;
          } else if (chunk == AiEvent.Done) {
            print("");
            streaming = false; // the reply is over, and everything has been read
          } else {
            // `AiEvent.Ready`: at least one chunk is waiting. `read()` drains everything
            // accumulated, and the next await asks for the one after it.
            write(session.read());
          }
        }
      }
    }

    }
  }

  session.close();
  print("--- end ---");
  finished = true;
}

/// 1 while the guest wants the host to drive it (0.7.0a). Cleared only after the
/// conversation is closed, so the host's exit cannot cut the closing line off.
let finished: bool = false;

export function _game_running(): i32 {
  return finished ? 0 : 1;
}

/// **Async, because the conversation is what the program *is*** (DL57).
///
/// It used to be sync and end with a bare `run(session)` — a call of an async function,
/// which under the stackful lowering is a *task factory*: the call built a handle and
/// dropped it, and the body it should have started sat in `run$spawnStart` where nothing
/// dispatched it. Measured (DL56): the entry printed its command list and stopped, with
/// zero parks. Awaiting the conversation makes the entry the task the host serves, which is
/// the shape the fiber shell was built for (DL54).
export async function _start_game(): void {
  // Bind the completion classes to their families — including the AI family —
  // before any await can park. Idempotent; `init` calls it too.
  rt.start();
  // The table the push path parks slots in (0.7.0a); one task parks at a time.
  __taskBindTable(8);

  // The stream needs a **session**: the completions arrive through the arena's
  // posting face, which only exists once one is open. The AI verbs themselves
  // work without it, but `await` cannot.
  const callbacks = rt.callbacks();
  const opened = RuntimeSession.open(ConfigBuilder.forThisBuild(callbacks), callbacks);
  if (opened != 0) {
    print("ai: the session refused to open (" + opened.toString() + ")");
    finished = true;
    return;
  }

  print("=== TensionCore AI demo ===");

  if (argCount() < 1) {
    print("usage: tension-core ai/build/story.wasm <model.gguf>");
    print("(the host requires a model key; the headless fallback ignores its value)");
    RuntimeSession.close();
    finished = true;
    return;
  }
  const modelPath: string = arg(0);
  print("model> " + modelPath);

  const cfg = new AiConfig().modelPath(modelPath).contextSize(2048).maxTokens(256).temp(0.8);
  print("loading model (this blocks until the weights are in; a few seconds) ...");
  const created: Session | null = Session.create(cfg);
  if (created === null) {
    print("(session_create failed — the host refused the configuration)");
    RuntimeSession.close();
    finished = true;
    return;
  }
  // Non-null from here, and the assertion lives in synchronous code.
  const session: Session = created!;

  session.add(AiRole.System, SYSTEM_PROMPT);
  print("Commands: /reset, /cancel, /quit");

  // **Awaited, not floated.** The entry parks in `run` and is resumed by the host for each
  // event the conversation waits on — a line, then a reply chunk. There is no loop here and
  // none in the guest below: the drive model is the host's.
  await run(session);
}
