{
  "name": "tension-example-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: the logging subsystem — levels, per-logger filtering, and the JSON layout",
  "scripts": {
    "build": "tensionscript game.ts -o build/game.wasm --runtime incremental --target release",
    "build:debug": "tensionscript game.ts -o build/game.wasm --runtime incremental --debug --sourceMap",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "plain",
    "hostArgs": [
      "--log-level=trace"
    ]
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.3.0"
  }
}
