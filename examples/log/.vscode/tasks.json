{
  // The pre-launch tasks. `asc` must emit the source map (`--debug --sourceMap`),
  // because that map is the only thing that links a wasm instruction back to a
  // source line; the launch config names the compound "debug" task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:debug",
      "type": "shell",
      "command": "npm run build:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "debug",
      "dependsOn": ["build:debug"],
      "dependsOrder": "sequence"
    }
  ]
}
