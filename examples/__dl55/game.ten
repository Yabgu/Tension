import { ConfigBuilder, RuntimeSession, print, rt } from "tension-framework";
export { __taskWake, __taskResume, __taskFail } from "~lib/task-rt";

// Module scope, not locals: the continuation lowering scopes a local declared near an
// `await` to its own resume guard, so a counter kept in a local would not survive a park.
// These are the probe's state.
let finished = false;
let resumes: i32 = 0;
let frame: i32 = 0;

export function _game_running(): i32 {
  return finished ? 0 : 1;
}

// Every `await rt.frame()` is a **real park**: the host's frame clock is the only thing
// that resolves `(FRAME, 0)`, so nothing in the guest can make it complete. If the await
// is a yield instead, the loop runs to completion in zero host iterations.
export async function _start_game(): void {
  rt.start();
  // No locals at all: the continuation lowering re-scopes a local across a park, and this
  // probe must be the same program on both backends (I103's territory, not this round's).
  if (RuntimeSession.open(ConfigBuilder.forThisBuild(rt.callbacks()), rt.callbacks()) != 0) {
    print("probe: session refused");
    finished = true;
    return;
  }

  while (frame < 2) {
    print("probe: park     frame=" + frame.toString() + " resumes=" + resumes.toString());
    await rt.frame();
    resumes += 1;
    print("probe: resume   frame=" + frame.toString() + " resumes=" + resumes.toString());
    frame += 1;
  }

  print("probe: done     resumes=" + resumes.toString());
  RuntimeSession.close();
  finished = true;
}
