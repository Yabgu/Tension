{
  "name": "tension-example-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: a YAML world integrated through source: \"world\" (rk45 on a spring oscillator)",
  "scripts": {
    "build": "asc game.ts -o build/game.wasm --runtime stub --target release --exportTable",
    "build:debug": "asc game.ts -o build/game.wasm --runtime stub --debug --sourceMap --exportTable",
    "run": "../../../tension-core/target/debug/tension-core build/game.wasm",
    "start": "npm run build && npm run run"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "assemblyscript": "~0.28.8"
  }
}
