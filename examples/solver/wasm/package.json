{
  "name": "tension-example-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: numerical integration over the tension::solver ABI (rk45 on y' = -y)",
  "scripts": {
    "build": "tensionscript game.ts -o build/game.wasm --runtime incremental --target release --exportTable",
    "build:debug": "tensionscript game.ts -o build/game.wasm --runtime incremental --debug --sourceMap --exportTable",
    "run": "node ../../../scripts/run-example.mjs --no-build",
    "start": "node ../../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "plain"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "@acakar/tensionscript": "^0.6.0"
  }
}
