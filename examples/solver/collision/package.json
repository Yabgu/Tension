{
  "name": "tension-example-collision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: two soft spheres in a square wall (rk45, source: \"wasm\") with a gnuplot animation",
  "scripts": {
    "build": "tensionscript game.ts -o build/game.wasm --runtime incremental --target release --exportTable --optimizeLevel 3",
    "build:debug": "tensionscript game.ts -o build/game.wasm --runtime incremental --debug --sourceMap --exportTable",
    "run": "node ../../../scripts/run-example.mjs --no-build",
    "start": "node ../../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "collision"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.8.1"
  }
}
