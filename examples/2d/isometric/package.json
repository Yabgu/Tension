{
  "name": "tension-example-isometric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: a worked isometric scene \u2014 oversized tileset, depth sort, modular character",
  "scripts": {
    "build": "node build.mjs && node ../../../scripts/build-2d-guest.mjs && node ../../../scripts/pack-example.mjs .",
    "build:debug": "node build.mjs && node ../../../scripts/build-2d-guest.mjs --debug && node ../../../scripts/pack-example.mjs .",
    "test": "node test.mjs",
    "test:synthetic": "node test-synthetic.mjs",
    "start": "tension-core --res build/isometric.tns build/game.wasm --windowed"
  },
  "tension": {
    "kind": "res",
    "pack": {
      "input": "assets",
      "output": "build/isometric.tns"
    }
  },
  "dependencies": {
    "@yabgu_gm/tension-core": "file:../../../packages/core",
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.1"
  }
}
