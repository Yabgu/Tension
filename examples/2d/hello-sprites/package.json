{
  "name": "tension-example-hello-sprites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: ten sprites rendered by tension-2d from a TensionScript guest",
  "scripts": {
    "build": "node ../../../scripts/build-2d-guest.mjs",
    "build:debug": "node ../../../scripts/build-2d-guest.mjs --debug",
    "test": "node test.mjs",
    "start": "tension-core build/game.wasm --window"
  },
  "tension": {
    "kind": "2d"
  },
  "dependencies": {
    "@yabgu_gm/tension-core": "file:../../../packages/core",
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.1"
  }
}
