{
  "name": "tension-example-isometric-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: the isometric scene built with the tension-framework SDK instead of hand-written records",
  "scripts": {
    "build": "node ../synthetic/emit.mjs . && node ../../../scripts/build-2d-guest.mjs && node ../../../scripts/pack-example.mjs .",
    "build:debug": "node ../synthetic/emit.mjs . && node ../../../scripts/build-2d-guest.mjs --debug && node ../../../scripts/pack-example.mjs .",
    "test": "node test.mjs",
    "start": "tension-core --res build/isometric-framework.tns build/game.wasm --window"
  },
  "tension": {
    "kind": "res",
    "pack": {
      "input": "assets",
      "output": "build/isometric-framework.tns"
    }
  },
  "dependencies": {
    "@yabgu_gm/tension-core": "file:../../../packages/core",
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.1"
  }
}
