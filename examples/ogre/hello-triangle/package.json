{
  "name": "tension-example-hello-triangle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: a triangle built out of guest memory with MeshBuilder, over the OGRE capability",
  "scripts": {
    "build": "asc game.ts --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm",
    "build:debug": "asc game.ts --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm --debug --sourceMap",
    "run": "node ../../../scripts/run-example.mjs --no-build",
    "start": "node ../../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "ogre"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework"
  },
  "devDependencies": {
    "assemblyscript": "~0.28.8"
  }
}
