{
  "name": "tension-example-animated-character",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: four characters, one mesh, four skins, three clips, deformed by OGRE's animation system",
  "scripts": {
    "build": "tensionscript game.ts --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm",
    "build:debug": "tensionscript game.ts --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm --debug --sourceMap",
    "run": "node ../../../scripts/run-example.mjs --no-build",
    "start": "node ../../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "ogre"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework",
    "@yabgu_gm/tension-core": "file:../../../packages/core",
    "@yabgu_gm/tension-ogre": "file:../../../packages/ogre",
    "@yabgu_gm/tension-ogre-next": "file:../../../packages/ogre-next",
    "@yabgu_gm/tension-freeimage": "file:../../../packages/freeimage"
  },
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.14.0"
  }
}
