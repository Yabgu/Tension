{
  "name": "tension-example-input-camera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: a WASD camera driven by tension::input, the host-owned-window layer",
  "scripts": {
    "build": "node ../../../scripts/tensionscript.mjs game.ten --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm --stackful-backend promise",
    "build:debug": "node ../../../scripts/tensionscript.mjs game.ten --config ../../../tension-framework/build/session.asconfig.json -o build/game.wasm --debug --sourceMap --stackful-backend promise",
    "start": "node ../../../scripts/run-example.mjs",
    "run": "node ../../../scripts/run-example.mjs --no-build"
  },
  "tension": {
    "kind": "ogre",
    "extraCapability": "../../../tension-input/build/libtension_input.so"
  },
  "dependencies": {
    "tension-framework": "file:../../../tension-framework",
    "@yabgu_gm/tension-core": "file:../../../packages/core",
    "@yabgu_gm/tension-ogre": "file:../../../packages/ogre",
    "@yabgu_gm/tension-ogre-next": "file:../../../packages/ogre-next"
  }
}
