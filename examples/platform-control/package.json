{
  "name": "tension-example-platform-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TensionCore example: the guest asks the host to resize the window, then polls for it",
  "scripts": {
    "build": "node ../../scripts/tensionscript.mjs game.ten -o build/game.wasm --config asconfig.json",
    "build:debug": "node ../../scripts/tensionscript.mjs game.ten -o build/game.wasm --config asconfig.json --debug --sourceMap",
    "run": "node ../../scripts/run-example.mjs --no-build",
    "start": "node ../../scripts/run-example.mjs"
  },
  "tension": {
    "kind": "plain"
  },
  "dependencies": {
    "tension-framework": "file:../../tension-framework",
    "@yabgu_gm/tension-core": "file:../../packages/core"
  }
}
