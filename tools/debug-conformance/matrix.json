    { "group": "A", "name": "async_statement_after_await", "program": "async-after-await", "file": "async-after-await.tension", "marker": "@stop" },
    { "group": "A", "name": "async_resume_in_loop", "program": "async-loop-resume", "file": "async-loop-resume.tension", "marker": "@stop" },
    { "group": "A", "name": "stack_switch_nested_resume", "program": "stack-switch-resume", "file": "stack-switch-resume.tension", "marker": "@stop" },
    { "group": "A", "name": "promise_backend_before_await", "program": "promise-fallback", "file": "promise-fallback.tension", "marker": "@stop" },
    { "group": "A", "name": "task_entry_first_statement", "program": "task-entry", "file": "task-entry.tension", "marker": "@stop" },
    { "group": "A", "name": "lambda_body", "program": "lambda-body", "file": "lambda-body.tension", "marker": "@stop" },
    { "group": "A", "name": "class_method", "program": "class-method", "file": "class-method.tension", "marker": "@stop" },
    { "group": "A", "name": "class_constructor", "program": "class-method", "file": "class-method.tension", "marker": "@stop2" },
    { "group": "A", "name": "second_function_in_file", "program": "second-function", "file": "second-function.tension", "marker": "@stop" },
    { "group": "A", "name": "entry_surface_main", "program": "start-game-entry", "file": "start-game-entry.tension", "marker": "@stop" },

    { "group": "B", "name": "async_on_main", "program": "async-on-main", "file": "async-on-main.tension", "transcript": "emit" },
    { "group": "B", "name": "main_policy", "program": "main-policy", "file": "main-policy.tension", "transcript": "print" },
    { "group": "B", "name": "fallback_loop", "program": "fallback-loop", "file": "fallback-loop.tension", "transcript": "print" },
