// DL30 Q1 — walk the serve chain in **main's own store**, one step at a time.
//
// # Why main and not a worker
//
// DL29 bounded the defect from outside: a worker spawned on an async entry prints nothing,
// and only index 0 (the body continuation) runs. The chain that fails lives in
// `std/assembly/thread.ts`'s `__workerMain` → `__serveOne` → `__resumeTask` and in the
// lowering's `$spawnStart` → `drive()`. A worker's store cannot be instrumented from the
// guest — the code under test *is* the thing that would have to print.
//
// So this probe reproduces the same steps in **main's** store, calling the same exported
// internals `__workerMain` calls. Every intermediate value is printable here, and — this is
// the part DL29 could not do — the value that comes back from each step can be compared
// against what the next step expects.
//
// # What it does, in order
//
//   1. binds the task table (`__taskBindTable`, exactly as a worker entry does);
//   2. prints both `__spawnIndexOf` answers, so the pinned 5-entry `$starts` shape is
//      visible and the indices are known rather than assumed;
//   3. `__serveSlot(3)` — makes `$starts[3]` (`workerEntryAsync$spawnStart`) a continuation
//      and answers its slot, which is what `__serveOne` does first;
//   4. `__resumeTask(slot)` — runs it; the answer is what `__serveOne` calls `awaited`;
//   5. `__taskAt(awaited)` — is there a **task** bound at that id? and what is that task's
//      own `slot`? If `awaited` names a continuation slot, `__taskAt(awaited)` should find
//      the task the lowering bound there;
//   6. `__resumeTask(awaited)` — the step `driveReady` would perform;
//   7. prints whether the body's line appeared.
//
// The step whose printed value is *not* what the next step expects is the failing link.
//
// Build (bundle aa74d6a1, I44) — by hand, from this directory:
//   tensionscript serve-chain-probe.ten -o /tmp/serve-chain.wasm \
//     --runtime incremental --target release --sharedMemory --importMemory \
//     --initialMemory 2 --maximumMemory 256 \
//     --enable threads --enable stack-switching --optimizeLevel 0
//
// Run:   tension-core --executors 2 /tmp/serve-chain.wasm
import { Task } from "~lib/task";
import { __spawnIndexOf } from "~lib/task-stack";
import {
  __bindTask,
  __resumeTask,
  __serveSlot,
  __taskAt,
} from "~lib/task-stack";
import { __taskBindTable } from "~lib/task-rt";
import { __executorExit, __spawnThread, __threadJoin } from "~lib/thread";

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function line(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

async function leaf(): i32 {
  return 0;
}

/** The stackful shell requires a root continuation: an exported async `main`. */
export async function main(): i32 {
  return await leaf();
}

/** The body under test. Its line is the last thing the chain should produce. */
async function workerEntryAsync(): i32 {
  line("BODY: workerEntryAsync ran");
  let v = await leaf();
  return v;
}

export function _start_game(): void {
  // A worker's entry does this first (`__workerMain`'s call path); main needs it for the
  // probe's `__taskAt`/`__bindTask` to have a table at all.
  __taskBindTable(16);
  line("step 0: task table bound");

  // 2. the two answers, and the pinned shape.
  // **One** `__spawnIndexOf` call site, so `$starts` is the 5-entry shape DL29 pinned:
  // [0] body · [1] mainStart · [2] coreloop · [3] spawnStart · [4] the factory.
  let api = __spawnIndexOf(workerEntryAsync);
  line("step 1: __spawnIndexOf(workerEntryAsync)=" + api.toString() + " (expect 4 = the factory)");

  // 3. serve `$starts[3]` = workerEntryAsync$spawnStart.
  let slot = __serveSlot(3);
  line("step 2: __serveSlot(3)=" + slot.toString());
  if (slot < 0) {
    line("STOP: __serveSlot refused");
    return;
  }

  // 4. run it. This is what `__serveOne` names `awaited`.
  let awaited = __resumeTask(slot);
  line("step 3: __resumeTask(serveSlot)=" + awaited.toString());

  // 5. is there a task at that id, and what does it think its own slot is?
  let taskOrNull = __taskAt(awaited);
  if (taskOrNull) {
    line("step 4: __taskAt(" + awaited.toString() + ")=a task, its .slot="
      + taskOrNull.slot.toString()
      + ", .entry=" + taskOrNull.entry.toString()
      + ", .settled=" + (taskOrNull.settled ? "1" : "0"));
  } else {
    line("step 4: __taskAt(" + awaited.toString() + ")=null (no task bound at that id)");
  }

  // 6. the step `driveReady` would take.
  if (awaited >= 0) {
    let second = __resumeTask(awaited);
    line("step 5: __resumeTask(awaited)=" + second.toString());
  } else {
    line("step 5: skipped — awaited was negative, so nothing would be queued");
  }

  line("probe: done (the BODY line above is the pass condition)");
}
