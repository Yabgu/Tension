// DL27 — the promise backend's cost probe: one task, N parks, N distinct keys.
//
// `wake-on-worker.ts` parks once. A *cost per await* needs N in one process, so this is
// that guest with a loop: the worker's async body awaits N hand-made records in
// sequence, each on its own key (`key = i`), so every park is a distinct pair and the
// ledger never displaces one.
//
// # The producer, and why the number is a floor
//
// `--post-completion-each-park 5,<N>` (DL27's flag): the host's **park seam** posts a
// completion for the key that just parked. That is the tightest cadence a producer can
// have — the host learns of the park the instant it is recorded — so the measured
// `queue_wait` is a lower bound on any real producer's, not a flattering special case.
//
// # Two things measured while writing it, both kept
//
// 1. **The key space bounded N before anything else did.** `scheduler::key_capacity`
//    answers `Some(768)` for the jobs family (`CLASS_JOB_DONE`, 4) and the seam refuses on
//    `key > bound`, so class 4 admits keys 0..=768 — 769 distinct keys, and the 770th park
//    is refused. Measured: 770 parks recorded, 769 wakes served, the refusal naming key
//    769. A 1000-key loop therefore needs a family whose bound is >= 1000, which
//    `CLASS_RESOURCE_READY` (5) is at 1024. So this guest uses class 5.
// 2. **Main must not spin.** The host bumps the served counter (`bump_served`) on every
//    wake, so a spinning main ping-pongs that cache line against the writer on every
//    single wake and burns a core competing with the thread it is waiting for — both of
//    which would be priced into the numbers as if they were engine cost. Main uses
//    `atomicWait` with a 20 ms timeout instead. A timeout is the *only* way the word is
//    ever noticed to change: the host cannot `atomic.notify` a guest (that is a wasm
//    instruction — DL20B's `signal_session_stop`).
//
// # What is measured
//
// Only the host times anything (`TENSION_MEASURE=1`), and it times segments, never a
// blend. This guest prints two lines — `BEFORE` once and `AFTER N` at the end — so the
// functional result is checkable with the instrument on and off, and it deliberately
// prints nothing per iteration: a formatted line costs microseconds and would be
// measured as part of the resume.
//
// Build (bundle aa74d6a1, I44) — by hand, from this directory:
//   tensionscript wake-loop.ten -o /tmp/wake-loop.wasm \
//     --runtime incremental --target release --sharedMemory --importMemory \
//     --initialMemory 2 --maximumMemory 256 \
//     --enable threads --optimizeLevel 0
//   ^ THREAD_FLAGS minus `--enable stack-switching`, as every other guest here.
//
// Run:
//   TENSION_MEASURE=1 tension-core --executors 2 \
//     --post-completion-each-park 5,1000 /tmp/wake-loop.wasm
//
// `PAIRS` is a constant in this file and the flag's `<N>` must match it. A mismatch is
// visible rather than silent: fewer posts strand (exit 1, naming the leftover task),
// more posts land in the sticky buffer and are dropped.
import { Task, TaskRecord } from "~lib/task";
import { __taskBindTable } from "~lib/task-rt";
import { __spawnIndexOf } from "~lib/task-stack";
import { atomicWait } from "~lib/atomics";
import { __executorExit, __spawnThread, __threadJoin } from "~lib/thread";

export { __taskWake } from "~lib/task-rt";

export function _game_running(): i32 {
  return 0;
}

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function line(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

/**
 * **`CLASS_RESOURCE_READY` (5), not `CLASS_JOB_DONE` (4), and the key space is why.**
 * `scheduler::key_capacity` admits 768 keys for the jobs family (0..767) and 1024 for
 * resources. A loop of 1000 distinct keys on class 4 puts keys 768..999 outside the
 * space, where the seam records a strand instead of a parkable entry — measured: the
 * run stopped at 769 wakes with "key 769" named in the refusal. Measuring 1000 pairs
 * therefore needs a family that holds 1000 keys.
 */
const CLASS_RESOURCE_READY: i32 = 5; // session/arena.rs:223
const HEADER_SERVED: usize = 6;

/** How many parks to take. Must equal the flag's `<N>`. */
const PAIRS: i32 = 1000;

function pendingJob(key: i32): Task<i32> {
  const record = new TaskRecord();
  record.class_ = CLASS_RESOURCE_READY;
  record.key = key;
  const handle = new Task<i32>();
  handle._record = record;
  return handle;
}

/** Await `PAIRS` completions in sequence, each on its own key. */
async function awaited(): i32 {
  let v: i32 = 0;
  for (let i = 0; i < PAIRS; i++) {
    let job: Task<i32> = pendingJob(i);
    v = await job;
  }
  return v;
}

async function workerEntry(): i32 {
  __taskBindTable(16);
  line("worker: BEFORE " + PAIRS.toString() + " awaits");
  let v: i32 = await awaited();
  // One line, at the end: printing per iteration would be measured as resume time.
  line("worker: AFTER " + PAIRS.toString() + " awaits, last=" + v.toString());
  return 0;
}

export function _start_game(): void {
  line("main: spawning");
  let index = __spawnIndexOf(workerEntry);
  line("main: index=" + index.toString());
  line("main: spawn=" + __spawnThread(1, index, 0).toString());

  // Wait until the host has served every wake, then stop the worker and join it.
  //
  // **`atomicWait`, not a spin, and that is a measurement decision, not a nicety.**
  // The host writes this word on every wake (`bump_served`), so a spinning main would
  // ping-pong that cache line against the worker's writer on every single wake and
  // burn a core competing with the thread it is waiting for. Either would be priced
  // into the numbers as if it were engine cost. The wait takes a timeout so a broken
  // run still reports instead of hanging.
  let served = <usize>__controlBase + HEADER_SERVED * 4;
  for (;;) {
    let now = atomicLoad<i32>(served);
    if (now >= PAIRS) break;
    // 20 ms. A timeout is not a failure — the loop re-reads and decides — and the
    // bound is this short because the host **cannot** notify a guest (`atomic.notify`
    // is a wasm instruction, DL20B's `signal_session_stop`): the timeout is the only
    // way this word is ever noticed to have changed. At 2 s the probe's wall clock
    // measured main's polling granularity rather than the worker's work.
    atomicWait<i32>(served, now, 20000000);
  }
  line("main: wakes served=" + atomicLoad<i32>(served).toString());

  __executorExit(1);
  line("main: join=" + __threadJoin(1).toString());
  line("main: done");
}
