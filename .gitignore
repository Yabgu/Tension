.codewhale

# Locally built Arch packages consumed by ci/Dockerfile (machine-local, large)
ci/ogre-next-pkg/

# Local scratch space (no /tmp — keep temp artifacts here)
.tmp/

# Rust
target/
Cargo.lock.orig

# Node
node_modules/
npm-debug.log*

# Build output
build/
# Out-of-source CMake tree (Ninja)
build-cmake/

# The example's packed volume is a build product (pack.sh regenerates it), and
# with the generated large asset inside it is far too big to commit.
examples/res/*.tns
dist/
*.wasm.map

# Model weights (examples expect these to be fetched/copied locally)
*.gguf

# Zig build artifacts
tension-res/.zig-cache/
tension-res/zig-out/


# Headless audio adapter render output
tension-audio.wav

# Editor / OS
*.swp
.DS_Store
# Root editor config is machine-local; examples/*/.vscode are tracked on purpose
/.vscode/

# Adapter and capability binaries: built by build.sh and dlopen'd, never committed
*.so
*.o
*.a

# Guests are compiled by asc; the fixtures that are text (.wat) are committed
*.wasm

# TensionScript-emitted declarations (tension-framework/index.d.ts is tracked
# and hand-written; ignore rules do not apply to already-tracked files)
*.d.ts

# Compiled binaries and scratch files (any toolchain)
*.obj
*.bin
*.dll
*.dylib
*.exe
*.log
# MSVC link products (import/static libs, export tables, symbols)
*.lib
*.exp
*.pdb
*.ilk
# Fortran module files (gfortran, tension-solver)
*.mod
*.mod0

# Python
__pycache__

# third_party builds (see third_party/bootstrap.sh)
third_party/ogre-next-build*/
third_party/ogre-next-install/

# runtime-migration verification artifacts (transcripts, build logs; regenerated)
tools/runtime-migration/out/

# python bytecode (compiled artifacts; never commit)
__pycache__/
*.pyc

# Native packages: the layout under packages/ is tracked, the binaries are not.
# `npm run build` populates a platform payload package per component; which one
# depends on the machine that built it, so none of them travel.
packages/*-win32-*/
packages/*-linux-*/
packages/*-darwin-*/
packages/*-win32-*/.package-lock.json

# The runner shims and resolvers in the meta packages are source: keep them.
!packages/core/bin/tension-core.js

# The pre-payload build copied lib/, include/ and Media/ into the meta packages
# themselves. Anything left there is a stale local build: the current build
# writes only to the platform payload packages above, so it must not travel.
packages/ogre/lib/
packages/ogre-next/lib/
packages/ogre-next/include/
packages/ogre-next/Media/
packages/core/bin/*
!packages/core/bin/tension-core.js

# packages/dist/ holds `npm pack` output for the future publish path. The root
# `dist/` rule above excludes it (and a negative rule cannot re-include a file
# whose parent directory is excluded), so the directory is un-ignored first and
# then its contents except the placeholder.
!packages/dist/
packages/dist/*
!packages/dist/.gitkeep

# What the packaged binaries were built from. Written by build-native.mjs; a
# machine-local fact (timestamps, the local commit), and run-example.mjs
# regenerates its expectations from the sources, so it does not travel.
packages/build-stamp.json

# Exception: these two guest modules are committed on purpose. They are the
# version-locked inputs to the DWARF E2E test (tests/e2e_debug.rs): one built by
# a compiler that embeds DWARF, one by a release that does not. Rebuilding them
# needs a specific compiler version, so drift would defeat the test. See the
# READMEs beside them.
!tension-core/tests/fixtures/dwarf-guest/game.wasm
!tension-core/tests/fixtures/legacy-guest/game.wasm
!tension-core/tests/fixtures/legacy-guest/game.wasm.map

# Scratch space for the 2D tests: generated synthetic pages, packed frames and
# run screenshots. Nothing here is a source; everything is regenerated by the
# script beside it. Kept out of git so a test run leaves the tree clean.
tension-2d/test-assets/
# The example's build output: sliced pages as IWI, plus the packed volume.
examples/2d/isometric/assets/
# Two of the three frames a run writes. `preview.png` is committed (it is the
# README's image, and it is small); the full-size ones churn on every run.
examples/2d/isometric/screenshots/back.png
examples/2d/isometric/screenshots/front.png
examples/2d/isometric-framework/screenshots/framework-back.png
examples/2d/isometric-framework/screenshots/framework-front.png

# Images: where one may live, and why (the full reasoning is in
# docs/spikes/records-budget.md, "The number is the evidence").
#
#   1. A screenshot that captures a MEASUREMENT is a test fixture in the test
#      tree, and a test must read or assert it. Being under tests/ is necessary,
#      not sufficient: a fixture no test touches is an orphan blob.
#   2. A UT/E2E reference image is a test-tree fixture the test diffs against.
#   3. A texture, font or other asset (license or generated provenance) lives in
#      the asset tree. It is input, not evidence; no test asserts it.
#   4. A screenshot as a doc illustration, or one with no asserting test, is
#      committed nowhere. The number in prose is the record.
#   5. Pre-existing PNGs on `main` (tension-framework/assets/preview/ui.N.png,
#      examples/2d/isometric/screenshots/preview.png, the framework preview)
#      predate this rule and stay as they are; they are not a precedent.
#
# So a spike's captures are ignored, and a measurement that must be guarded is
# asserted as a number (parse the output, compare to a constant), not as pixels.
docs/spikes/*.png
