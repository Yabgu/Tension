      "statics": "  /// A perspective camera looking down its own -Z (an OGRE camera's default).\n  /// The viewport stays 0 x 0, which means the window's whole size.\n  /// The identity rotation is set here: the value twin defaults to zero.\n  static perspective(fovY: f32, aspect: f32, near: f32, far: f32, x: f32 = 0,\n                     y: f32 = 0, z: f32 = 0): CameraRecord {\n    const camera = new CameraRecord();\n    camera.fovY = fovY;\n    camera.aspect = aspect;\n    camera.nearClip = near;\n    camera.farClip = far;\n    camera.position.x = x;\n    camera.position.y = y;\n    camera.position.z = z;\n    camera.rotation.w = 1;\n    return camera;\n  }"
    },
