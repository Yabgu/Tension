      "statics": "  /// A node at a place, with the identity rotation and unit scale `at` sets.\n  /// `parentId` stays 0: hierarchy is refused in this chunk.\n  static at(x: f32 = 0, y: f32 = 0, z: f32 = 0): SceneNode {\n    const node = new SceneNode();\n    node.position.x = x;\n    node.position.y = y;\n    node.position.z = z;\n    node.rotation.w = 1;\n    node.scale.x = 1;\n    node.scale.y = 1;\n    node.scale.z = 1;\n    return node;\n  }"
    },
