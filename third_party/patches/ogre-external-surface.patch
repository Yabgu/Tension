-                                           mConnection, mScreen->root_visual ) )
+        // With a host-supplied surface there is no xcb window and no xcb
+        // connection here: the host owns both, and presentation support was
+        // settled when the host created the surface.
+        if( !mExternalSurfaceKHR )
         {
-            OGRE_EXCEPT( Exception::ERR_RENDERINGAPI_ERROR, "Vulkan not supported on given X11 window",
-                         "VulkanXcbWindow::_initialize" );
+            if( !get_xcb_presentation_support( mDevice->mPhysicalDevice,
+                                               mDevice->mGraphicsQueue.mFamilyIdx, mConnection,
+                                               mScreen->root_visual ) )
+            {
+                OGRE_EXCEPT( Exception::ERR_RENDERINGAPI_ERROR,
+                             "Vulkan not supported on given X11 window",
+                             "VulkanXcbWindow::_initialize" );
+            }
         }
 
         VulkanTextureGpuManager *textureManager =
@@ -213,6 +221,12 @@ namespace Ogre
         if( mDevice->isDeviceLost() )  // notifyDeviceRestored() will call us again
             return;
 
+        // The host may have created the surface already (SDL_Vulkan_CreateSurface
+        // on the window SDL owns, Wayland or X11 alike). Then there is no
+        // platform surface to make and no window handle needed.
+        if( adoptExternalSurface() )
+            return;
+
         PFN_vkCreateXcbSurfaceKHR create_xcb_surface = (PFN_vkCreateXcbSurfaceKHR)vkGetInstanceProcAddr(
             mDevice->mInstance->mVkInstance, "vkCreateXcbSurfaceKHR" );
 
