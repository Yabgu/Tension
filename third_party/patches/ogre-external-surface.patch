+
+        // A host-supplied surface has no ANativeWindow of ours to measure: the
+        // host resized the window and told us through requestResolution.
+        if( mExternalSurfaceKHR )
+        {
+            if( mRequestedWidth == getWidth() && mRequestedHeight == getHeight() &&
+                !mRebuildingSwapchain )
+                return;
+
+            mDevice->stallIgnoringDeviceLost();
