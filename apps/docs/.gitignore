# Build output: the bundle, the index, the atlas and the recorded transcripts.
# They are products of tools/, and a committed copy would be a second source of
# truth for the documentation — the failure `docs/known-issues.md` exists to
# catalogue.
assets/

# The wasm, the packed volume and the resolved asconfig `tension dev` writes.
build/

# The self-contained app `tension build` writes.
dist/

node_modules/

# Emitted by `tension dev`; the viewer uses preset 1, so this is never written,
# but the CLI emits it for a 2D project and an unexplained file is worse than an
# ignored one.
src/graph.generated.ts

# Emitted by `scripts/assets.mjs`: the framework's baked metrics, mirrored into
# this app so `verify-atlas.mjs` can check this app's atlas against the constants
# the guest compiles in. The framework's copy is the source; this is a product.
src/ui-fonts.generated.ts

# Screenshots taken while checking the viewer on a machine: blobs that grow with
# every UI change and that no build or test reads.
screenshots/
