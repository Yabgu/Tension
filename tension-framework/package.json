{
  "name": "tension-framework",
  "version": "0.1.0",
  "description": "Guest SDK for TensionCore: the capability bindings (tension::io, audio, ai, res, solver, ogre, input, 2d) and the game abstractions built on them",
  "type": "module",
  "ascMain": "assembly/index.ts",
  "types": "index.d.ts",
  "scripts": {
    "build": "tensionscript index.ts -o build/index.wasm --runtime incremental --target release --optimizeLevel 3",
    "test": "cd .. && node scripts/test.mjs --framework && node tension-framework/tests/rt-dispatch.mjs",
    "build:fixture": "bash tests/run.sh"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts"
    }
  },
  "files": [
    "assembly",
    "index.ts",
    "index.d.ts"
  ],
  "keywords": [
    "tension",
    "wasm",
    "tensionscript",
    "text-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "@yabgu_gm/tensionscript": "^0.13.2"
  }
}
