{
  "name": "tension-framework",
  "version": "0.1.0",
  "description": "Guest SDK for TensionCore: tension::io ABI bindings and game abstractions (AssemblyScript + TypeScript)",
  "type": "module",
  "ascMain": "assembly/index.ts",
  "types": "index.d.ts",
  "scripts": {
    "build": "tensionscript index.ts -o build/index.wasm --runtime incremental --target release",
    "test": "bash tests/run.sh && node tests/rt-dispatch.mjs",
    "build:fixture": "bash tests/run.sh"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts"
    }
  },
  "files": [
    "assembly",
    "index.ts",
    "index.d.ts"
  ],
  "keywords": [
    "tension",
    "wasm",
    "assemblyscript",
    "text-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "@acakar/tensionscript": "file:../tools/assemblyscript-fork/acakar-tensionscript-0.3.3.tgz"
  }
}
