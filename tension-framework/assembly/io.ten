// Guest-side bindings for the Tension host ABI (`tension::io`).
//
// The guest imports these functions from the host under the wasm module
// name `tension::io`; tension-core implements them. The compiled game never
// touches the terminal directly. Strings cross the boundary as UTF-8 bytes:
//
//   print(ptr, len)          write exactly `len` UTF-8 bytes at `ptr` to
//                            stdout (no newline appended — the SDK owns the
//                            line terminator)
//   read_line(ptr, cap)      read one line (terminator stripped):
//                            cap <= 0 probes the next line's byte length
//                            without consuming it; cap > 0 consumes the
//                            line, writes min(cap, len) bytes, returns len.
//                            -1 on EOF, 0 for an empty line.
//   arg_count() -> i32       number of extra CLI args passed to the game
//   arg(i, ptr, cap) -> i32  write arg i as UTF-8; returns byte count (-1
//                            OOB); cap == 0 probes the size without writing
//   log(level, name_ptr, name_len, msg_ptr, msg_len)
//                            hand one record to the host logger: `level` is a
//                            tension_log_level_t (0 trace .. 5 fatal), the
//                            logger name and message are UTF-8 byte ranges
//   log_structured(level, name_ptr, name_len, json_ptr, json_len)
//                            the same, with a JSON payload in place of the
//                            message (the JSON layout splices it)
//
// Every string crosses as UTF-8 bytes with an explicit byte count
// (`String.UTF8.byteLength` / `String.UTF8.encode`), never the UTF-16 code-unit
// count `str.length` reports — the two differ for any non-ASCII text.
//
// Because the wrappers below probe the exact size before consuming, the
// guest never requests a partial line, so UTF-8 codepoint-boundary
// truncation cannot occur in the decode path — a consequence of the
// read_line contract, not a separate fix.

import { Task, TaskRecord } from "~lib/task";
import { CLASS_IO_READY } from "./runtime/wire";

import { __inputSupported } from "~lib/io";

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

@external("tension::io", "read_line")
declare function hostReadLine(ptr: usize, cap: i32): i32;

@external("tension::io", "input_arm")
declare function hostInputArm(source: i32): i32;

@external("tension::io", "input_read")
declare function hostInputRead(source: i32, ptr: usize, cap: i32): i32;

@external("tension::io", "arg_count")
declare function hostArgCount(): i32;

@external("tension::io", "arg")
declare function hostArg(i: i32, ptr: usize, cap: i32): i32;

@external("tension::io", "log")
declare function hostLog(
  level: i32,
  namePtr: usize,
  nameLen: i32,
  msgPtr: usize,
  msgLen: i32,
): void;

@external("tension::io", "log_structured")
declare function hostLogStructured(
  level: i32,
  namePtr: usize,
  nameLen: i32,
  jsonPtr: usize,
  jsonLen: i32,
): void;

/** Write text to stdout with no trailing newline. */
export function write(text: string): void {
  const bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
}

/** Write a line to stdout (appends a newline). */
export function print(text: string): void {
  write(text);
  write("\n");
}

/** Read one line from stdin (trailing newline stripped). Returns null at
 *  EOF and "" for an empty line. */
export function readLine(): string | null {
  const need = hostReadLine(0, 0); // probe: non-consuming size query
  if (need < 0) return null; // EOF
  // Always follow the probe with a *consuming* call. An empty line probes as
  // 0, and the probe never consumes, so returning early here would leave the
  // line parked in the host forever: every later readLine would see the same
  // 0 and stdin would never advance. cap > 0 selects the consuming path, and
  // for an empty line it writes min(cap, 0) == 0 bytes, so the 1-byte buffer
  // below is only there to make the call a consuming one.
  const buf = new ArrayBuffer(need > 0 ? need : 1);
  const n = hostReadLine(changetype<usize>(buf), need > 0 ? need : 1);
  if (n < 0) return null;
  return n > 0 ? String.UTF8.decodeUnsafe(changetype<usize>(buf), n) : "";
}

// ── input as an event, not a blocking call (DL57, I135) ────────────────────
//
// **What this replaces.** `readLine()` reads stdin inline. On the fiber backend the guest's
// stack *is* a host thread, so that call blocks the host's own loop — the loop that would
// have delivered the next line. Measured four ways on `examples/ai` (DL56): the first read
// never returned, the prompt never printed, and there were **zero parks**, because the guest
// was not waiting in the completion ABI at all. So a guest that wants input now awaits an
// event, and the host reads on its own thread.
//
// **The shape carries a second consumer unchanged.** `source` is the key, and a socket or a
// file reader posts on the same family with its own descriptor: the guest changes the
// number, not the program.
//
//     inputArm(0);
//     let event: InputEvent = await inputTask(0);
//     if (event == InputEvent.Line) { let line: string = readLineNow(); }
//
// **One await per event.** The handle resolves on the next thing the source produces, so a
// loop awaits once per line and prints it as it arrives — never "is there more yet".

/** What a completed input wait names. The **event**, never a byte count. */
export enum InputEvent {
  /** A line arrived; take it with `readLineNow()`. */
  Line = 0,
  /** The source produced nothing more: stdio closed, a socket hung up, a file ended. */
  End = 1,
}

/** `input_arm`'s answer when the host has no such source. */
export const INPUT_NO_SOURCE: i32 = -38;

/**
 * Start the host reading `source` on its own thread. Idempotent; `0` on success.
 *
 * 0 is stdin. Any other number is a source this build does not have yet, and answers
 * `INPUT_NO_SOURCE` rather than parking a task on a completion nobody will post.
 */
export function inputArm(source: i32): i32 {
  return hostInputArm(source);
}

/**
 * The awaitable for the next event on `source`.
 *
 * The handle carries `(IO_READY family, source)` — the same stamped-record shape `rt.job`
 * and `rt.stream` build — so `await` parks on it and the host's post settles it. The value
 * the await answers is the {@link InputEvent}.
 */
export function inputTask(source: i32): Task<InputEvent> {
  // **Compile-time, not run-time.** A backend that cannot park a producer handle compiles
  // this call to an error naming itself, so there is no build in which this program waits
  // forever or reads a zero nobody posted (DL57, decision 5).
  __inputSupported();
  const record = new TaskRecord();
  record.class_ = CLASS_IO_READY;
  record.key = source;
  const handle = new Task<InputEvent>();
  handle._record = record;
  return handle;
}

/**
 * Pop the line the last {@link InputEvent.Line} announced, from `source` (0 = stdin).
 *
 * Called **after** the event, never instead of waiting for one: the queue is filled by the
 * reader thread before it posts, so the line an event names is already there.
 *
 * The `source` argument is the whole of what changes between consumers — a caller awaiting
 * a file source writes `readLineNow(1)` and not one other line of its program.
 */
export function readLineNow(source: i32 = 0): string {
  // Same probe/consume split as `readLine`: the probe reports the length and does not
  // consume, so a caller that only wants to know whether a line is there can ask twice.
  const need = hostInputRead(source, 0, 0);
  if (need < 0) return "";
  const buf = new ArrayBuffer(need > 0 ? need : 1);
  const n = hostInputRead(source, changetype<usize>(buf), need > 0 ? need : 1);
  if (n < 0) return "";
  return n > 0 ? String.UTF8.decodeUnsafe(changetype<usize>(buf), n) : "";
}

/** Number of extra CLI arguments passed to the game. */
export function argCount(): i32 {
  return hostArgCount();
}

/** The i-th extra CLI argument, or "" when out of range. */
export function arg(i: i32): string {
  const need = hostArg(i, 0, 0); // probe size with cap == 0
  if (need < 0) return "";
  const buf = new ArrayBuffer(need == 0 ? 1 : need);
  const n = hostArg(i, changetype<usize>(buf), need);
  if (n < 0) return "";
  return String.UTF8.decodeUnsafe(changetype<usize>(buf), n);
}

/**
 * Hand one record to the host logger.
 *
 * `level` is a `tension_log_level_t` (0 trace .. 5 fatal); `name` and `message`
 * cross as UTF-8 bytes. The host owns the level, the filter, the layout and the
 * sink — this only carries what the guest knows. `Logger` in `./log` is the
 * ergonomic wrapper; this is the raw binding under it.
 *
 * The byte lengths are `String.UTF8.byteLength`, not `message.length`: the host
 * reads exactly that many bytes, so the UTF-16 count would truncate any message
 * containing a non-ASCII character.
 */
export function log(level: i32, name: string, message: string): void {
  const nameBytes = String.UTF8.encode(name);
  const msgBytes = String.UTF8.encode(message);
  hostLog(
    level,
    changetype<usize>(nameBytes),
    nameBytes.byteLength,
    changetype<usize>(msgBytes),
    msgBytes.byteLength,
  );
}

/**
 * Hand one structured record to the host logger: `json` is expected to be a JSON
 * object the JSON layout splices as `data`.
 */
export function logStructured(level: i32, name: string, json: string): void {
  const nameBytes = String.UTF8.encode(name);
  const jsonBytes = String.UTF8.encode(json);
  hostLogStructured(
    level,
    changetype<usize>(nameBytes),
    nameBytes.byteLength,
    changetype<usize>(jsonBytes),
    jsonBytes.byteLength,
  );
}
