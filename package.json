{
  "name": "tension",
  "version": "0.1.0",
  "private": true,
  "description": "Tension: a wasm engine for the TensionScript guest language, with the OGRE capability and the OGRE wire records generated from one schema.",
  "type": "module",
  "scripts": {
    "build": "npm run build:codegen && npm run build:native && npm run build:framework && npm run build:examples",
    "build:codegen": "node tools/codegen/generate.mjs --schema schema/ogre.json --out-ts tension-framework/assembly/ogre/generated --out-h tension-ogre/src/generated",
    "build:framework": "node scripts/build-framework.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "build:native": "node scripts/build-native.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "pack:all": "node scripts/pack-all.mjs",
    "test": "node scripts/test.mjs",
    "docs:abi": "node scripts/gen-abi-doc.mjs",
    "test:abi-docs": "node scripts/test-abi-docs.mjs",
    "check:eol": "node scripts/normalize-eol.mjs --check",
    "fix:eol": "node scripts/normalize-eol.mjs",
    "demo": "node scripts/demo.mjs",
    "verify:res": "node scripts/verify-res.mjs",
    "build:hlms-skin": "node scripts/build-hlms-skin.mjs",
    "test:ozz": "node scripts/test-ozz.mjs",
    "ci": "node ci/docker.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
