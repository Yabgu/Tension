# Build output: the wasm, the packed volume, and the resolved asconfig.
build/

# The self-contained game `tension build` writes.
dist/

node_modules/

# Generated by `tension dev` on every build, from the host's own emission. It is
# versioned with the runtime, not with your project, so committing it would let
# a stale blob outlive an upgrade.
src/graph.generated.ts
