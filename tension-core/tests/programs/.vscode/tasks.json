{
  // The build half: one task per program, one command each.
  //
  // Each command is the compiler, the source file, the output file and the
  // flags — nothing wrapped, nothing generated. `--debug --sourceMap` is what
  // puts the `.debug_*` sections and the source map beside the artifact;
  // without both, a breakpoint in the `.ten` has nothing to bind against.
  //
  // The flags match `scripts/build-test-programs.mjs` (this folder is a
  // table of them, there a program name maps to the same list), and
  // `tension-core/tests/launch_config.rs` fails if a task here stops naming the
  // source and output that its launch configuration opens.
  "version": "2.0.0",
  "tasks": [
    {
      // async/async-on-main.ten -> build/debug/async-on-main.wasm
      "type": "shell",
      "label": "build: async-on-main",
      "command": "node ../../../scripts/tensionscript.mjs async/async-on-main.ten -o build/debug/async-on-main.wasm --runtime incremental --target release --enable stack-switching --exportStart __start --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // async/main-policy.ten -> build/debug/main-policy.wasm
      "type": "shell",
      "label": "build: main-policy",
      "command": "node ../../../scripts/tensionscript.mjs async/main-policy.ten -o build/debug/main-policy.wasm --runtime incremental --target release --enable stack-switching --exportStart __start --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // async/main-step-replaced.ten -> build/debug/main-step-replaced.wasm
      "type": "shell",
      "label": "build: main-step-replaced",
      "command": "node ../../../scripts/tensionscript.mjs async/main-step-replaced.ten -o build/debug/main-step-replaced.wasm --runtime incremental --target release --enable stack-switching --exportStart __start --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // async/schedule-order.ten -> build/debug/schedule-order.wasm
      "type": "shell",
      "label": "build: schedule-order",
      "command": "node ../../../scripts/tensionscript.mjs async/schedule-order.ten -o build/debug/schedule-order.wasm --runtime incremental --target release --enable stack-switching --exportStart __start --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // async/fallback-loop.ten -> build/debug/fallback-loop.wasm
      "type": "shell",
      "label": "build: fallback-loop",
      "command": "node ../../../scripts/tensionscript.mjs async/fallback-loop.ten -o build/debug/fallback-loop.wasm --runtime incremental --target release --enable stack-switching --exportStart __start --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // async/rt-guards.ten -> build/debug/rt-guards.wasm
      "type": "shell",
      "label": "build: rt-guards",
      "command": "node ../../../scripts/tensionscript.mjs async/rt-guards.ten -o build/debug/rt-guards.wasm --runtime incremental --target release --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // thread/count.ten -> build/debug/count.wasm
      "type": "shell",
      "label": "build: count",
      "command": "node ../../../scripts/tensionscript.mjs thread/count.ten -o build/debug/count.wasm --runtime incremental --target release --sharedMemory --importMemory --initialMemory 2 --maximumMemory 256 --enable threads --enable stack-switching --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // thread/spawn-join.ten -> build/debug/spawn-join.wasm
      "type": "shell",
      "label": "build: spawn-join",
      "command": "node ../../../scripts/tensionscript.mjs thread/spawn-join.ten -o build/debug/spawn-join.wasm --runtime incremental --target release --sharedMemory --importMemory --initialMemory 2 --maximumMemory 256 --enable threads --enable stack-switching --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // thread/two-workers.ten -> build/debug/two-workers.wasm
      "type": "shell",
      "label": "build: two-workers",
      "command": "node ../../../scripts/tensionscript.mjs thread/two-workers.ten -o build/debug/two-workers.wasm --runtime incremental --target release --sharedMemory --importMemory --initialMemory 2 --maximumMemory 256 --enable threads --enable stack-switching --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // thread/spawn-refusals.ten -> build/debug/spawn-refusals.wasm
      "type": "shell",
      "label": "build: spawn-refusals",
      "command": "node ../../../scripts/tensionscript.mjs thread/spawn-refusals.ten -o build/debug/spawn-refusals.wasm --runtime incremental --target release --sharedMemory --importMemory --initialMemory 2 --maximumMemory 256 --enable threads --enable stack-switching --optimizeLevel 0 --debug --sourceMap",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      // Every program at once, through the one recipe the Rust tests use.
      "type": "shell",
      "label": "build: all programs",
      "command": "node ../../../scripts/build-test-programs.mjs --debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "host: build (debug)",
      "command": "cargo build --manifest-path ${workspaceFolder}/../../../tension-core/Cargo.toml",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
