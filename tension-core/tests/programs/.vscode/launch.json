{
  // One configuration per program, and each one names the exact file it runs.
  //
  // There is no picker and no runner script in the debug path: what you see in
  // `args` below is the whole command line, in the order the host receives it.
  // `build/debug/<name>.wasm` is the artifact with DWARF in it — the release
  // `build/<name>.wasm` has no `.debug_*` sections, so a `.ts` breakpoint
  // cannot bind in it and the run still looks normal.
  //
  // `preLaunchTask` compiles that one program (see tasks.json: the command is
  // the compiler, the source, the output and the flags, spelled out).
  //
  // `initCommands` turns the GDB JIT loader on: without it lldb never sees the
  // guest image and every breakpoint stays pending.
  //
  // `windows` overrides the host to `.exe`; a path without it will not launch.
  //
  // The thread programs get `--executors 2` because that is what
  // `tension-core/tests/threads.rs` runs them with: two workers plus main.
  "version": "0.2.0",
  "configurations": [
    {
      // async/await on one stack, no threads: three suspensions, one carried local
      "type": "lldb",
      "request": "launch",
      "name": "debug: async-on-main",
      "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/debug/async-on-main.wasm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "initCommands": [
        "settings set plugin.jit-loader.gdb.enable on",
        "settings set target.debug-file-search-paths ${workspaceFolder}"
      ],
      "sourceMap": { ".": "${workspaceFolder}" },
      "preLaunchTask": "build: async-on-main",
      "stopOnEntry": false
    },
    {
      // a program replaces main's step and wraps the default
      "type": "lldb",
      "request": "launch",
      "name": "debug: main-policy",
      "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/debug/main-policy.wasm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "initCommands": [
        "settings set plugin.jit-loader.gdb.enable on",
        "settings set target.debug-file-search-paths ${workspaceFolder}"
      ],
      "sourceMap": { ".": "${workspaceFolder}" },
      "preLaunchTask": "build: main-policy",
      "stopOnEntry": false
    },
    {
      // a program owns the scheduling decision outright
      "type": "lldb",
      "request": "launch",
      "name": "debug: main-step-replaced",
      "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/debug/main-step-replaced.wasm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "initCommands": [
        "settings set plugin.jit-loader.gdb.enable on",
        "settings set target.debug-file-search-paths ${workspaceFolder}"
      ],
      "sourceMap": { ".": "${workspaceFolder}" },
      "preLaunchTask": "build: main-step-replaced",
      "stopOnEntry": false
    },
    {
      // three policies, three creation orders, one resume order — the transcript is the schedule
      "type": "lldb",
      "request": "launch",
      "name": "debug: schedule-order",
      "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core",
      "windows": {
        "program": "${workspaceFolder}/../../../tension-core/target/debug/tension-core.exe"
      },
      "args": [
        "--debug",
        "--symbol-path",
        "${workspaceFolder}",
        "${workspaceFolder}/build/debug/schedule-order.wasm"
