// **Spawned work runs, on fiber** (DL61, I95) — three tasks, none awaited.
//
// The defect this guards, in its final shape: a program that spawned N tasks and awaited
// none of them ran **zero** bodies on the fiber backend and still exited 0. The ready
// queue, the drain point and the submit rule all existed (DL59/DL60); what was missing was
// ordering in the compiler — `__driveSlot` was compiled *after* the override stubs were
// finalized, so `TaskBase#drive`'s virtual stub was emitted as a bare `unreachable` and the
// record's own synthesized `drive` was never compiled:
//
//     Error: a spawned task at slot 1 trapped: … !~lib/task/TaskBase#drive@override
//
// Three questions, and a transcript alone answers none of them completely:
//
// 1. **The artifact can hand a slot over**: it imports `scheduler::ready` and exports
//    `__driveSlot`. Without both, "the bodies ran" would have to mean the guest ran them
//    itself, which is the pumping this design refuses.
// 2. **All three bodies run, exactly once each, in submission order** (the default FIFO
//    policy), leaving a transcript of `entry / ran 1 / ran 2 / ran 3`.
// 3. **It is the same on both backends.** The continuation build of this file reads the
//    same transcript; a per-backend difference here would mean the two "run" differently,
//    which is the thing a policy layer could never paper over.
//
// A `work` body that awaits something is deliberate: an async function with no `await` is
// not lowered at all (its call is an ordinary call), so a probe without one measures
// nothing — DL59 learned that the hard way.

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function say(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

async function leaf(id: i32): i32 { return id; }

async function work(id: i32): void {
  let value: i32 = await leaf(id);
  say("ran " + value.toString());
}

export function _start_game(): void {
  say("entry");
  // **A floating spawn: no `await`.** This call in statement position *is* the program
  // saying "start this and do not wait", and it is what the compiler rewrites into the
  // hand-over.
  work(1);
  work(2);
  work(3);
}
