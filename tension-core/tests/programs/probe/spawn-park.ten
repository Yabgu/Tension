// **A floating spawn that parks** (DL63, I152/I153).
//
// `examples/spawn` claimed "two suspensions, so each body is a real fiber task" while its
// bodies awaited a helper that only `return 0`ed — and an async function with no `await`
// in its body is not lowered at all (DL59's lesson), so those were ordinary calls and the
// comment was false. A transcript could not tell the difference; the artifact can.
//
// This probe is that claim made checkable: the body awaits `rt.frame()`, so the artifact
// must import `scheduler::park`, and the body must still run to completion.
//
// **What it does not yet prove, and the report says so:** on fiber today a park made
// inside a body that the ready drain started returns immediately instead of suspending —
// the body resumes with the default 0 and no producer has posted (I153). That is why the
// frame number printed below is 0 and why the four OGRE examples' loads fail with `-EIO`
// (the framework reads "success record with no resource id" as a lost completion). The
// assertion here is the *import*, which is a claim about how the code was compiled, plus
// the transcript, which is a claim about what ran.
import { rt } from "../../../../tension-framework/assembly/runtime/rt";

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function line(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

async function body(): void {
  line("body before await rt.frame()");
  let frame: i32 = await rt.frame();
  line("body after await rt.frame() (frame " + frame.toString() + ")");
}

export function _start_game(): void {
  rt.start();
  line("entry");
  body();                       // a floating spawn: no await, value dropped
  line("entry after spawn");
}
