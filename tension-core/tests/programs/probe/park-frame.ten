// **`await rt.frame()` on a producer handle is a real park** (DL56, I103).
//
// The defect this pins: `await` on a handle — `rt.frame()`, `rt.job(id)`, the AI verbs —
// compiled to the operand itself, because the lowering's rule is "if the operand isn't a
// task it built, `await` is the operand". A handle *is* a `Task<T>`, so it took the inline
// path, `drive()` was empty, and the awaited value came back as `0` with nothing having
// happened. The guest looped, the host saw no park, and the artifact imported no
// `scheduler::park` at all.
//
// No session and no `_game_running`: this probe is about the *park*, and `rt.start()` binds
// the completion families without one (the same minimal state `async/rt-guards.ten` uses).
// A host-driven guest has to export `__taskWake` as well, and the fiber path needs no host
// loop — the parks are answered by the producer that drives `__start`. What resolves
// `rt.frame()` is the host's clock and nothing else, so a yield cannot make the guest
// finish the way a park does.
//
// The assertions are `tests/park_frame.rs`: the host's own post/resume count and the park
// import in the artifact, because a transcript alone cannot tell a park from a fast yield.
import { rt } from "../../../../tension-framework/assembly/runtime/rt";

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function line(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

// Module scope, not locals: the continuation lowering scopes a local declared near an
// `await` to its own resume guard, so a counter kept in a local would not survive a park.
let resumes: i32 = 0;
let frame: i32 = 0;

export async function _start_game(): void {
  rt.start();
  while (frame < 2) {
    line("probe: park     frame=" + frame.toString() + " resumes=" + resumes.toString());
    await rt.frame();
    resumes += 1;
    line("probe: resume   frame=" + frame.toString() + " resumes=" + resumes.toString());
    frame += 1;
  }
  line("probe: done     resumes=" + resumes.toString());
}
