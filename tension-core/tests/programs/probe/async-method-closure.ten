// **`this` captured by a closure after a suspension** (DL62) — the case a naive lift breaks.
//
// The body of `async run()` runs on a fiber, so a suspension keeps the whole frame and an
// arrow written *after* the await still reads `this`. That is only true because the body
// stayed a member of the class: a lift to a free function would have to rewrite every `this`
// — including the one inside this arrow, which lives in a nested closure the transform does
// not otherwise look into.
//
// The property asserted is the *value*: `closure reads 7` and, after the arrow assigns,
// `closure wrote 9`. A lift that lost the receiver would read 0 (or trap).

@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function line(text: string): void {
  let bytes = String.UTF8.encode(text);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

async function leaf(id: i32): i32 { return id; }

class Holder {
  value: i32 = 7;

  async run(): void {
    await leaf(1);
    // An arrow that captures `this` — declared and called after the suspension.
    let read = (): i32 => this.value;
    line("closure reads " + read().toString());
    let bump = (by: i32): void => { this.value += by; };
    bump(2);
    line("closure wrote " + this.value.toString());
  }
}

export function _start_game(): void {
  new Holder().run();
}
