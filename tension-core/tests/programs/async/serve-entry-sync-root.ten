// **A sync entry that submits a task, on the fiber backend** (DL60, I140).
//
// The shape this pins is the smallest one that reaches `$serveEntry`:
//
//   `_start_game` is **sync**, so the fiber build prepares no shell (DL54's residue);
//   `work` is async but **not an entry**, so `emitStartsTable` emitted no start for it
//   and the table was empty. `__submitTask` still leads to `__serveCont` — through
//   `__executorInit`'s reference to `__mainStep__` → `__drainInbox` → `__serveOne` →
//   `__serveSlot` — and on this backend `__serveCont` is `call $serveEntry(index)`.
//   With the body suppressed, that call had no target:
//
//     [wasm-validator error in function ~lib/task-stack/__serveSlot]
//     unexpected false: call target must exist, on (call $$serveEntry (local.get $0))
//
// So the compiler refused a program whose only defect was the shape of its entry.
// The fix emits `$serveEntry` (and the `__driveSlot` export) on every fiber build;
// this program is what goes red without it. It prints one line, so a run — not only a
// build — can assert the artifact still works.
//
// `work` is submitted explicitly rather than through a bare statement call: DL60
// measured that the statement-position rule does not yet reach this backend (the
// synthesized task records carry no `drive` body — I142), so a bare `work(1);` is not
// a spawn here and the explicit form is what a program must write today.
// The host's own print, not the framework's: a test program that pulled the framework
// in would need three memory pages and the thread flags give two (AS105, measured).
@external("tension::io", "print")
declare function hostPrint(ptr: usize, len: i32): void;

function print(s: string): void {
  let bytes = String.UTF8.encode(s);
  hostPrint(changetype<usize>(bytes), bytes.byteLength);
  let newline = String.UTF8.encode("\n");
  hostPrint(changetype<usize>(newline), newline.byteLength);
}

import { __submitTask } from "~lib/thread";

async function leaf(id: i32): i32 { return id; }
async function work(id: i32): void {
  let v: i32 = await leaf(id);
  print("ran " + v.toString());
}

export function _start_game(): void {
  print("entry");
  __submitTask(work(1));
}
